<!DOCTYPE html>
{{!-- Website template by freewebsitetemplates.com --}}
<html>
<head>
  <meta charset="UTF-8">
  {{!-- HBS injects the title value passed from the travel controller --}}
  <title>{{title}}</title>
  <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
  <div id="background">
    <div id="page">
      {{!-- Insert the shared header partial --}}
      {{> header}}
      <div id="contents">
        <div class="box">
          <div>
            <div class="body">
              <h1>Travel</h1>
              <ul id="sites">
                {{!-- Loop through each trip object passed in from the controller --}}
                {{#each trips}}
                <li>
                  {{!-- this.image and this.name reference properties on each trip object --}}
                  <a href="/travel"><img src="{{this.image}}" alt="Img"></a>
                  <h2><a href="/travel">{{this.name}}</a></h2>
                  {{!-- Triple braces render the HTML tags inside the description string --}}
                  {{{this.description}}}
                </li>
                {{/each}}
              </ul>
            </div>
          </div>
        </div>
      </div>
      {{!-- Insert the shared footer partial --}}
      {{> footer}}
    </div>
  </div>
</body>
</html>