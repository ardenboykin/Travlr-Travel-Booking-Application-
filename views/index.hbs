<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  {{!-- HBS injects the title value passed from the main controller --}}
  <title>{{title}}</title>
  <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
  <div id="background">
    <div id="page">
      {{!-- Insert the shared header partial --}}
      {{> header}}
      <div id="contents">
        <div id="adbox">
          <img src="images/sea-sound.jpg" alt="Img">
          <h1>Enjoy the Summer with Us!</h1>
        </div>
      </div>
      {{!-- Insert the shared footer partial --}}
      {{> footer}}
    </div>
  </div>
</body>
</html>